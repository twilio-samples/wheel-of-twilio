TWILIO_ACCOUNT_SID="ACxxxxx"
TWILIO_API_KEY="SKxxxxx"
TWILIO_API_SECRET="xxxxx"
TWILIO_AUTH_TOKEN="xxxxx"
EVENT_NAME="DevEvent 2024"
NEXT_PUBLIC_WEDGES="San Francisco,London,Paris,Madrid,Berlin,New York,Munich,Barcelona,Amsterdam,Vienna"
NEXT_PUBLIC_TWILIO_PHONE_NUMBER="+4918601860"
# TWILIO_PHONE_NUMBER is derived automatically from NEXT_PUBLIC_TWILIO_PHONE_NUMBER
# by deploy.sh — only set this manually if they need to differ
MAX_BETS_PER_USER="0"
VERIFY_SERVICE_SID="VAxxxxxxx"
SYNC_SERVICE_SID="ISxxxxxx"
BASIC_AUTH_USERNAME="twilio"
BASIC_AUTH_PASSWORD="admin!"

# Hide QR code and related elements (defaults to false)
# Set to "true" to hide the QR code, CTA text, phone number, and QR-related disclaimer
NEXT_PUBLIC_HIDE_QR_CODE=false

# Number of prizes available per wedge/field (defaults to unlimited if not set or 0)
# Set to a positive number to limit prizes per field
NEXT_PUBLIC_PRIZES_PER_FIELD=5

#Optional
OFFERED_PRIZES="big"
LEAD_COLLECTION="MANUAL"
SMALL_PRIZES="Twilio Sticker Pack"

# Required for QR mode (LEAD_COLLECTION=QR)
TWILIO_CONVERSATION_CONFIGURATION_ID="your_conversation_configuration_id"
TWILIO_MEMORY_STORE_ID="your_memory_store_id"

# WEAREDEVS_TEMP: WeAreDevelopers World Congress badge lookup API key.
# When set, QR mode fetches real attendee data from the WeAreDevelopers API
# instead of using the random stub. Remove after the event.
# WEAREDEVS_LEAD_COLLECTION_KEY=""
